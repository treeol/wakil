# compiled binaries
/wakil
/wakil-old
/wakil-*

# python artifacts
__pycache__/
*.pyc
*.pyo

# local config that may hold secrets
config.json
.config/
.env

# editor/OS noise
*.swp
*.swo
*~
.DS_Store
wakil_race

# IDE / tooling
.idea/
.vscode/
.claude/worktrees/

# /plan workflow runtime artifacts
.wakil/

# local temp/workspace docs
.tmp/
.tmp-test/

# archived docs — preserved on archive/docs branch, not tracked on master
docs/archive/

# plan/audit markdown — session artifacts, not tracked
b2-b5-plan*.md
branch-audit.md

# experiment / run directories
runs/

# trace output
*.trace
*.jsonl.trace

# kvrust is no longer a submodule — it's cloned at build time in the Dockerfile.
# If cloned locally for testing, ignore it so it doesn't pollute git status.
/kvrust/

# go build cache (sandbox /tmp is tiny)
.tmp-gocache/
.tmp-gobuild/
.gotmp/
.gocache/
master.key
