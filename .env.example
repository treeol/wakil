# .env.example — copy to .env and edit before running docker compose.
#
# cp .env.example .env
# # then edit .env with your actual values

# Host user UID/GID — the container runs as this user so it can read/write
# mounted host directories. Get these with: id -u  /  id -g
WAKIL_UID=1000
WAKIL_GID=1000

# Host workspace path — the directory you would normally run `wakil` from.
# Must be an absolute path. If the path contains symlinks, use the
# fully-resolved path (realpath /home/user/myproject) so the workspace
# identity key matches the TUI.
WAKIL_WORKSPACE_PATH=/home/user/myproject

# Exec mode: "direct" (commands run in-container) or "docker" (daemon spawns
# sandbox containers — requires Docker socket access).
WAKIL_EXEC_MODE=direct
