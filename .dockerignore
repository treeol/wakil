# Exclude everything not needed for the build to keep the build context small.
# The Dockerfile.daemon only needs the Go source tree, go.mod, and go.sum.

# Build artifacts and caches
runs/
.tmp/
.gotmp/
*.test
*.out

# Git
.git/

# Docker (avoid recursive build context)
Dockerfile
docker-compose.yml

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs and traces (if under repo root)
*.log
traces/

# Node modules (if any frontend tooling exists)
node_modules/

# Data directories (should never be in the image)
data/
